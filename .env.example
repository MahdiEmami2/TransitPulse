# TransitPulse Configuration
# Copy this file to .env and adjust values as needed.
# WARNING: Never commit the real .env file.

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (PostgreSQL)
# Uses the psycopg2 driver supplied by psycopg2-binary.
DATABASE_URL=postgresql+psycopg2://transitpulse:transitpulse@localhost:5432/transitpulse
# Faster async alternative (requires the asyncpg package):
# DATABASE_URL=postgresql+asyncpg://transitpulse:transitpulse@localhost:5432/transitpulse

# ML Model
MODEL_PATH=./models/latest.pkl
MODEL_RETRAIN_ENABLED=false

# CORS (comma-separated origins, use * for all)
CORS_ORIGINS=*

# Synthetic data
SYNTHETIC_DATA_DAYS=365
SYNTHETIC_SEED=42

# Ingestion
INGEST_BATCH_SIZE=1000

# Logging
LOG_FORMAT=json  # json | text